# StoryArchitect AI v4.0 环境变量示例（APP_* 覆盖 config.toml）
# 优先级：DB app_config（白名单热键） > 进程 env > 数据目录 .env > config.toml > 内置默认

APP_BIND="127.0.0.1:8080"          # 0.0.0.0 时强制启动令牌（§12.1）
APP_DATA_DIR=""                    # 空 = 平台默认数据目录
APP_LLM__PROVIDER="deepseek"
APP_LLM__BASE_URL="https://api.deepseek.com/v1"
APP_LLM__MODEL="deepseek-chat"
APP_LLM__FALLBACKS=""
APP_LLM__CONNECT_TIMEOUT_SECONDS="5"
APP_LLM__ATTEMPT_TIMEOUT_SECONDS="45"
APP_LLM__MAX_RETRIES="2"
APP_SANDBOX__MAX_CONCURRENT="4"    # 1..16
APP_SANDBOX__MAX_STEPS="20"
APP_SANDBOX__STEP_TIMEOUT_SECONDS="90"
APP_SANDBOX__SESSION_TIMEOUT_SECONDS="1800"
APP_SANDBOX__HISTORY_MAX_TOKENS="6000"
APP_SANDBOX__CONTEXT_HARD_CAP_TOKENS="12000"
APP_SANDBOX__ROLLING_SUMMARY_MAX_TOKENS="500"
APP_SANDBOX__DIRECTOR_REPEAT_LIMIT="3"
APP_SANDBOX__WAITING_INPUT_TIMEOUT_SECONDS="300"
APP_HTTP__BODY_LIMIT_BYTES="2097152"
APP_HTTP__IMPORT_BODY_LIMIT_BYTES="67108864"
APP_HTTP__SSE_HEARTBEAT_SECONDS="15"
APP_HTTP__DEV_CORS="false"         # true 仅放行 http://localhost:5173（D-28）
APP_RECYCLE__RETENTION_DAYS="30"
APP_COST__MONTHLY_BUDGET_USD=""
APP_LOG__LEVEL="info"
APP_LOG__TRACE_PROMPT="false"      # true 会记录 Prompt 全文（敏感）
APP_FTS_MIN_QUERY_LENGTH="2"

# 密钥只从环境读取，不写入 config.toml
# APP_LLM_API_KEY="sk-..."
# APP_LLM_FALLBACK_API_KEY_1="sk-..."
